# ── Copy this file to `.env.local` and fill in real values. ────────────────
# Next.js loads `.env.local` / `.env` at runtime — NOT `.env.example`.

MONGODB_URI=mongodb://127.0.0.1:27017/awok
NEXTAUTH_SECRET=replace-with-long-random-string-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Stripe: use the SAME mode for both (both test sk_test_ / pk_test_ OR both live).
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

PLATFORM_ACCOUNT_COUNTRY=US
NEXT_PUBLIC_SITE_URL=http://localhost:3000
