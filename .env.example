# ── Copy this file to `.env.local` and fill in real values. ────────────────
# Next.js loads `.env.local` / `.env` at runtime — NOT `.env.example`.

MONGODB_URI=mongodb://127.0.0.1:27017/awok
NEXTAUTH_SECRET=replace-with-long-random-string-min-32-chars
# Production (each custom domain): https://awok.onlineorders.store / https://onopokebar.onlineorders.store
NEXTAUTH_URL=http://localhost:3000

# Stripe: use the SAME mode for both (both test sk_test_ / pk_test_ OR both live).
# Required for `/api/orders/lookup` to pull Stripe and mark orders paid when the success page polls (webhook alone is not enough if this is unset).
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret for `POST /api/stripe/webhook` — must match the webhook endpoint in Stripe Dashboard for this deployment URL (test vs live).
STRIPE_WEBHOOK_SECRET=whsec_...
# Signing secret for the connected account webhook (direct charge flow).
# Register a second webhook endpoint on the connected account in Stripe Dashboard pointing to the same
# /api/stripe/webhook URL, then paste its signing secret here.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

PLATFORM_ACCOUNT_COUNTRY=US
# Production: canonical https URL for this deployment (e.g. https://awok.onlineorders.store). Used as Stripe success/cancel
# base when the request host is missing or localhost, so customers return to the correct site for /api/orders/lookup polling.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Multi-domain: map Host → Restaurant.slug (Mongo). Optional JSON overrides built-in awok/onopokebar.*.onlineorders.store rules.
# RESTAURANT_HOST_SLUG_MAP={"awok.onlineorders.store":"a-wok","onopokebar.onlineorders.store":"ono-poke-bar"}
RESTAURANT_HOST_SLUG_MAP=
# Single-tenant override when Host does not match (e.g. server-side jobs): defaults to a-wok
RESTAURANT_SLUG=

# ── Transactional email (Mailgun preferred; Resend or SMTP fallback) ───────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Optional full RFC From, e.g. "A Wok <orders@mg.example.com>"
MAILGUN_FROM=
MAILGUN_FROM_EMAIL=
# If empty, restaurant display name from SiteSetting / DB is used
MAILGUN_FROM_NAME=

# Full https logo URL for transactional emails (e.g. Cloudinary). Overrides SiteSetting/Restaurant logo when set.
# Must be https:// and publicly reachable (not localhost). Alias: RESTAURANT_EMAIL_LOGO_URL
ORDER_EMAIL_LOGO_URL=\

RESTAURANT_ORDER_EMAIL=
ADMIN_ORDER_EMAIL=
ORDER_CC_EMAIL=
ORDER_FROM_EMAIL=

EMAIL_PROVIDER=
RESEND_API_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Set to "false" to skip the customer order confirmation email only
ORDER_SEND_CUSTOMER_CONFIRMATION=true

# EU Mailgun: set https://api.eu.mailgun.net (optional; US default if unset). Alias: MAILGUN_ENDPOINT
MAILGUN_API_URL=

# Set to 1 for temporary server logs: order id, email flags, Mailgun domain, to/from, exit reasons (never logs API keys)
ORDER_EMAIL_TRACE_LOG=
