# ── Copy this file to `.env.local` and fill in real values. ────────────────
# Next.js loads `.env.local` / `.env` at runtime — NOT `.env.example`.

MONGODB_URI=mongodb://127.0.0.1:27017/awok
NEXTAUTH_SECRET=replace-with-long-random-string-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Stripe: use the SAME mode for both (both test sk_test_ / pk_test_ OR both live).
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

PLATFORM_ACCOUNT_COUNTRY=US
# Production: set to your public https URL (used as fallback when request host is localhost).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Multi-domain: map Host → Restaurant.slug (Mongo). Optional JSON overrides built-in awok/onopokebar.*.onlineorders.store rules.
# RESTAURANT_HOST_SLUG_MAP={"awok.onlineorders.store":"a-wok","onopokebar.onlineorders.store":"ono-poke-bar"}
RESTAURANT_HOST_SLUG_MAP=
# Single-tenant override when Host does not match (e.g. server-side jobs): defaults to a-wok
RESTAURANT_SLUG=

# ── Transactional email (Mailgun preferred; Resend or SMTP fallback) ───────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Optional full RFC From, e.g. "A Wok <orders@mg.example.com>"
MAILGUN_FROM=
MAILGUN_FROM_EMAIL=
# If empty, restaurant display name from SiteSetting / DB is used
MAILGUN_FROM_NAME=

# Full https logo URL for transactional emails (e.g. Cloudinary). Overrides SiteSetting/Restaurant logo when set.
# Must be https:// and publicly reachable (not localhost). Alias: RESTAURANT_EMAIL_LOGO_URL
ORDER_EMAIL_LOGO_URL=\

RESTAURANT_ORDER_EMAIL=
ADMIN_ORDER_EMAIL=
ORDER_CC_EMAIL=
ORDER_FROM_EMAIL=

EMAIL_PROVIDER=
RESEND_API_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Set to "false" to skip the customer order confirmation email only
ORDER_SEND_CUSTOMER_CONFIRMATION=true
